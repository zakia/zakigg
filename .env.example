# Local development configuration for zaki.gg.
# Copy to .env and fill in the values you need.

# GCS asset storage. Credentials come from Application Default Credentials:
#   gcloud auth application-default login
# On Cloud Run these come from Terraform (infra/); GCP_PROJECT_ID is optional locally.
GCP_PROJECT_ID=zaking
GCS_BUCKET=zaking-note-assets-us-east1

# Admin password for the private editor. If unset, dev auto-signs-in as admin
# (production always requires a password).
ADMIN_PASSWORD=

# Notes cloud sync — local development configuration.
# Copy to .env and fill in. On Cloud Run these come from Terraform (infra/).
#
# Credentials for Firestore/GCS come from Application Default Credentials:
#   gcloud auth application-default login

# GCP project (needed locally; on Cloud Run the metadata server provides it)
GCP_PROJECT_ID=

# GCS bucket for note asset blobs (Terraform output: <project>-note-assets)
NOTES_GCS_BUCKET=

# The single Google account allowed to sync
NOTES_SYNC_ALLOWED_EMAIL=azakica@gmail.com

# OAuth 2.0 Web Client ID (GCP console > APIs & Services > Credentials).
# Authorized JavaScript origins: https://zaki.gg and http://localhost:5173
PUBLIC_GOOGLE_CLIENT_ID=

# Session cookie HMAC secret: openssl rand -base64 32
NOTES_SYNC_SESSION_SECRET=

# Optional: point Firestore at the local emulator instead of the real project
# FIRESTORE_EMULATOR_HOST=localhost:8484

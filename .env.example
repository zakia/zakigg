# Local development configuration for the private editor and Git content store.
# Copy to .env and fill in. On Cloud Run these come from Terraform (infra/).
#
# Credentials for GCS come from Application Default Credentials:
#   gcloud auth application-default login

# GCP project (needed locally; on Cloud Run the metadata server provides it)
GCP_PROJECT_ID=

# GCS bucket for note asset blobs (Terraform output: <project>-note-assets)
NOTES_GCS_BUCKET=

# One-time legacy export only. The current us-east1 database is named "zakigg";
# use "(default)" when exporting the older Toronto database instead.
FIRESTORE_DATABASE_ID=zakigg

# The single Google account allowed to sign in
AUTH_ALLOWED_EMAIL=you@example.com

# OAuth 2.0 Web Client ID (GCP console > APIs & Services > Credentials).
# Authorized JavaScript origins: https://zaki.gg and http://localhost:5173
PUBLIC_GOOGLE_CLIENT_ID=

# Session cookie HMAC secret: openssl rand -base64 32
AUTH_SESSION_SECRET=

# GitHub App installed only on the content repository with Contents: read/write.
# Keep the private key server-side; escaped newlines are accepted.
GITHUB_CLIENT_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
